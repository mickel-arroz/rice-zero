# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright: la sesion que deja el proyecto de preparacion (es una cookie de
# verdad, de la cuenta de usar y tirar) y lo que escupe una corrida fallida.
/e2e/.auth/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# stack local de Supabase (npm run verify:supabase). Es scratch de Docker: el
# esquema de verdad vive en db/, compartido por todos los proveedores.
/supabase/

# typescript
*.tsbuildinfo
next-env.d.ts

# El service worker compilado. Lo genera `app/serwist/[path]/route.ts` en el
# build, así que versionarlo solo sirve para que se quede viejo.
/public/sw*.js
/public/swe-worker*.js
