# Ejemplo de .env.local. Genera el real con el wizard del backend que uses.
#
# Un solo Proveedor de Backend está activo a la vez (ver CONTEXT.md y
# docs/adr/0001-proveedor-de-backend-intercambiable.md). Esta variable es el
# interruptor: cambiarla y redesplegar es todo lo que hace falta para pasar de
# un proveedor a otro.
NEXT_PUBLIC_BACKEND=neon

# ── Neon (activo) ─────────────────────────────────────────────────────────
# Genera estas con: bash scripts/setup-neon.sh
#
# La NEXT_PUBLIC_ es pública por diseño: la autorización vive en las políticas
# RLS, que el motor evalúa contra el JWT que firma Managed Better Auth y
# verifica pg_session_jwt contra el JWKS.
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-....apirest.c-5.us-east-2.aws.neon.tech/neondb/rest/

# La Auth URL ya NO es pública: desde el #7 el navegador habla con /api/auth,
# una ruta de esta app que proxea a Managed Better Auth y convierte la sesión en
# una cookie httpOnly de PRIMERA parte. Quien necesita esta URL es el servidor.
# Ver docs/adr/0002-sesion-de-primera-parte.md.
NEON_AUTH_URL=https://ep-....neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-....neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Con lo que el servidor FIRMA esa cookie. NO sale de la consola de Neon: la
# generas tú con `openssl rand -base64 32` (mínimo 32 caracteres), y el wizard lo
# hace por ti. Sin ella, proxy.ts no podría distinguir una sesión de verdad de
# una inventada. Si cambia, todas las sesiones abiertas caducan.
NEON_AUTH_COOKIE_SECRET=

# NO es pública. Es la cadena del rol neondb_owner, que tiene BYPASSRLS y se
# salta todas las políticas: la usan `npm run db:apply` y `npm run verify:neon`,
# y nada más.
DATABASE_URL=postgresql://neondb_owner:...@ep-....neon.tech/neondb?sslmode=require

# ── Supabase (dormido) ────────────────────────────────────────────────────
# Genera estas con: bash scripts/setup-supabase.sh
# Solo hacen falta si NEXT_PUBLIC_BACKEND=supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-referencia.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tampoco es pública, y es el equivalente de DATABASE_URL: solo DDL.
# `npm run verify:supabase` la deduce sola cuando apunta al Supabase local de
# Docker, así que esta línea es solo para un proyecto hospedado.
SUPABASE_DB_URL=postgresql://postgres:...@db.tu-referencia.supabase.co:5432/postgres

# ── Proveedor de IA ───────────────────────────────────────────────────────
# El interruptor de la capa de IA, hermano de NEXT_PUBLIC_BACKEND. Igual que
# aquél, no tiene default: un despliegue al que se le olvidara serviría
# Análisis inventados por el proveedor falso y nadie se enteraría.
#
#   gemini  el de verdad. Necesita GEMINI_API_KEY.
#   falso   no llama a nadie. Para trabajar en el panel sin gastar cuota, y lo
#           que `npm test` fuerza siempre (ver vitest.setup.ts).
#
# NO es NEXT_PUBLIC_: la generación corre en un Server Action, y el navegador
# no tiene por qué saber qué modelo hay detrás.
AI_PROVIDER=gemini

# La API key de Gemini. NO es pública y no puede serlo: se lee dentro de
# lib/ai/adapters/gemini/, que es `server-only`, y ESLint impide importar ese
# SDK desde cualquier otro sitio. Sácala en https://aistudio.google.com/apikey
# (free tier). El modelo NO se configura aquí: es AI_CONFIG.geminiModel en
# lib/constants.ts, porque los ids de Gemini son volátiles y ahí queda escrito
# contra qué página de pricing se verificó y cuándo.
GEMINI_API_KEY=

# ── Corrida en vivo (opcional) ────────────────────────────────────────────
# Enciende `npm run account:live` y `npm run test:contract:live`, que ejercitan
# el SDK del proveedor ACTIVO — lo único que la suite en memoria no puede probar.
#
#   npm run account:live        registra la cuenta
#   …confirmas el email…
#   npm run test:contract:live  la contract suite entera
#
# ⚠ Esa cuenta es de usar y tirar: la suite BORRA todos sus Proyectos entre
# bloques. Nunca la apuntes a una cuenta con datos que te importen.
BACKEND_CONTRACT_LIVE=
BACKEND_CONTRACT_EMAIL=
BACKEND_CONTRACT_PASSWORD=

# Enciende `npm run ai:live`: TRES generaciones de verdad contra Gemini, con
# los dos árboles del criterio de aceptación del #15 (uno desde cero, otro
# arreglando algo ya desplegado) más uno con Directrices.
#
# Va aparte de GEMINI_API_KEY a propósito, igual que BACKEND_CONTRACT_LIVE: la
# key está en .env.local porque el panel la necesita en desarrollo, y eso no
# debe bastar para que una corrida despistada se coma la cuota del día.
AI_LIVE=

# Añade a esa corrida la contract suite ENTERA contra Gemini: la que
# lib/ai/testing/contract.ts dice que el adaptador tiene que pasar. Son doce
# llamadas más, y el free tier las puede cortar por límite de peticiones por
# minuto — de ahí que sea una segunda llave y no el comportamiento por defecto.
AI_LIVE_CONTRACT=

# ── Suite E2E (opcional) ──────────────────────────────────────────────────
# Enciende `npm run test:e2e`: Playwright contra el Proveedor de Backend ACTIVO
# —Neon— con el proveedor de IA falso, así que la suite nunca gasta cuota.
#
#   npm run test:e2e        la suite entera (escritorio + móvil emulado)
#   npm run test:e2e:ui     el modo interactivo, para escribir pruebas
#
# ⚠ Esa cuenta es de usar y tirar: la SEMILLA borra TODOS sus Proyectos antes
#   de cada corrida, para que la número cien empiece igual que la primera.
#   Nunca la apuntes a una cuenta con datos que te importen.
#
# E2E_LIVE va aparte de las credenciales por lo mismo que BACKEND_CONTRACT_LIVE:
# unas credenciales sueltas no deben bastar para empezar a borrar.
#
# La semilla usa además DATABASE_URL (arriba) para confirmar el email por SQL y
# vaciar la cuenta, igual que `npm run account:verify`.
E2E_LIVE=
E2E_EMAIL=
E2E_PASSWORD=

# Opcional: contra qué servidor corre. Sin ella, Playwright construye la app y
# levanta el suyo en http://localhost:3100.
#
# `localhost` y no `127.0.0.1`: son orígenes distintos, y Managed Better Auth
# solo confía en los registrados — contra `127.0.0.1` toda petición de auth
# vuelve `INVALID_ORIGIN`. Y el 3100 y no el 3000, que es el de `next dev`: un
# `next build` escribe sobre el mismo `.next` que aquél está sirviendo.
#
# Ponla a un servidor que ya tengas levantado para iterar sin esperar al build.
# Si lo haces, arráncalo TÚ con AI_PROVIDER=falso: el runner se niega a correr
# sin eso, porque este atajo se salta el entorno que fija playwright.config.ts.
#
#   AI_PROVIDER=falso npx next start --port 3100
#   E2E_BASE_URL=http://localhost:3100 npm run test:e2e
E2E_BASE_URL=

# ── Smoke del despliegue (opcional) ───────────────────────────────────────
# Enciende `npm run smoke`: solo comprobaciones PÚBLICAS y no destructivas
# contra una URL ya desplegada. No entra con ninguna cuenta y no escribe nada.
#
#   SMOKE_URL=https://tu-app.vercel.app npm run smoke
SMOKE_URL=
